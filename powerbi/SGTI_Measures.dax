// SGTI.DAX
// Copie todos estos calculos en el modelo de Power BI (Model -> New measure / New table).
// Se asume que las tablas tienen el mismo nombre que los archivos Parquet.

// ---------------------------------------------------------------------------
// Tabla de fechas (crear como "Nueva tabla")
// ---------------------------------------------------------------------------
Dim_Fecha =
    ADDCOLUMNS(
        CALENDARAUTO(),
        "Anio",          YEAR([Date]),
        "MesNumero",     MONTH([Date]),
        "Mes",           FORMAT([Date], "MMMM"),
        "MesCorto",      FORMAT([Date], "MMM"),
        "Trimestre",     "T" & FORMAT(QUARTER([Date]), "0"),
        "AnioTrimestre", YEAR([Date]) * 4 + QUARTER([Date]) - 1,
        "SemanaISO",     WEEKNUM([Date], 21),
        "DiaNumero",     WEEKDAY([Date], 2),
        "DiaSemana",     FORMAT([Date], "dddd"),
        "DiaMes",        DAY([Date]),
        "EsFinDeSemana", WEEKDAY([Date], 2) >= 6
    )

// ---------------------------------------------------------------------------
// KPIs transversales (contadores)
// ---------------------------------------------------------------------------
Total Personal Hospital       = COUNTROWS(personal_hospital)
Total Personal TI             = COUNTROWS(personal_ti)
Total Usuarios Sistema        = COUNTROWS(usuarios_sistema)
Total Coordinaciones          = COUNTROWS(coordinaciones)
Total Oficios Recibidos       = COUNTROWS(oficios_recibidos)
Total Oficios Realizados      = COUNTROWS(oficios_realizados)
Total Notas Informativas      = COUNTROWS(notas_informativas)
Total Asignaciones Licencia   = COUNTROWS(asignaciones_licenciamiento)
Total Ingresos Suministro     = COUNTROWS(ingresos_suministro)
Total Entregas Suministro     = COUNTROWS(entregas_suministro)
Total Cuentas Usuario         = COUNTROWS(cuentas_usuario)
Total Eventos Auditoria       = COUNTROWS(audit_log)
Total Reubicaciones           = COUNTROWS(historico_reubicaciones_equipos)
Total Incidencias Acceso      = COUNTROWS(incidencias_control_acceso)
Total Vacaciones Incidencias  = COUNTROWS(vacaciones_incidencias)
Total Puertas                 = COUNTROWS(control_acceso_puertas)
Total Sitios Monitorizados    = COUNTROWS(monitor_sites)

// ---------------------------------------------------------------------------
// Licenciamiento
// ---------------------------------------------------------------------------
Licencias Activas =
    CALCULATE(
        COUNTROWS(asignaciones_licenciamiento),
        asignaciones_licenciamiento[estatus] = "ACTIVA"
    )
% Licencias Activas =
    DIVIDE([Licencias Activas], [Total Asignaciones Licencia], 0)

Licencias Asignadas Hoy = [Total Asignaciones Licencia]  // placeholder por fechas

// ---------------------------------------------------------------------------
// Documentos (oficios y notas)
// ---------------------------------------------------------------------------
Oficios Contestados =
    CALCULATE(COUNTROWS(oficios_recibidos), oficios_recibidos[contestado] = TRUE())

% Of. Recibidos Contestados =
    DIVIDE([Oficios Contestados], [Total Oficios Recibidos], 0)

Oficios Cancelados =
    CALCULATE(COUNTROWS(oficios_realizados), oficios_realizados[cancelado] = TRUE())

Oficios Entregados =
    CALCULATE(COUNTROWS(oficios_realizados), oficios_realizados[entregado] = TRUE())

Promedio Dias Contestacion Recibidos =
    AVERAGEX(oficios_recibidos, oficios_recibidos[dias_transcurridos])

% Notif. Encendidas =
    DIVIDE(
        CALCULATE(COUNTROWS(oficios_recibidos), oficios_recibidos[notificacion] = TRUE()),
        [Total Oficios Recibidos],
        0
    )

// ---------------------------------------------------------------------------
// Suministros e inventario
// ---------------------------------------------------------------------------
Unidades Ingresadas      = SUM(ingresos_suministro[cantidad])
Monto Ingresado (MXN)    = SUM(ingresos_suministro[monto])
Unidades Entregadas      = SUM(entregas_suministro[cantidad])
Unidades Consumidas      = SUM(entregas_suministro_consumos[cantidad])
Unidades Disponibles     = SUM(ingresos_suministro[cantidad_disponible])

% Unidades Entregadas del Ingreso =
    DIVIDE([Unidades Entregadas], [Unidades Ingresadas], 0)

// ---------------------------------------------------------------------------
// Reubicaciones de equipo
// ---------------------------------------------------------------------------
Reubicaciones Completadas =
    CALCULATE(COUNTROWS(historico_reubicaciones_equipos),
        historico_reubicaciones_equipos[estatus] = "COMPLETADO")

% Reubicaciones Completadas =
    DIVIDE([Reubicaciones Completadas], [Total Reubicaciones], 0)

// ---------------------------------------------------------------------------
// Auditoria (RLS: este rol ve solo esta tabla)
// ---------------------------------------------------------------------------
Eventos Por Accion (Crear) =
    CALCULATE(COUNTROWS(audit_log), audit_log[accion] = "CREAR")

Eventos Por Accion (Actualizar) =
    CALCULATE(COUNTROWS(audit_log), audit_log[accion] = "ACTUALIZAR" OR audit_log[accion] = "EDITAR")

Eventos Por Accion (Eliminar) =
    CALCULATE(COUNTROWS(audit_log), audit_log[accion] = "ELIMINAR")

% Eventos de Eliminacion =
    DIVIDE([Eventos Por Accion (Eliminar)], [Total Eventos Auditoria], 0)

// ---------------------------------------------------------------------------
// Monitor de sitios
// ---------------------------------------------------------------------------
Sitios Activos =
    CALCULATE(COUNTROWS(monitor_sites), monitor_sites[activo] = TRUE())

% Tiempo Arriba (por sitio activo, latencia promedio) =
    AVERAGE(monitor_sites[last_latency_ms])

Notificaciones Abajo =
    CALCULATE(COUNTROWS(monitor_notifications), monitor_notifications[event_type] = "DOWN")

Notificaciones Recuperadas =
    CALCULATE(COUNTROWS(monitor_notifications), monitor_notifications[event_type] = "RECOVERED")

// ---------------------------------------------------------------------------
// Control de acceso
// ---------------------------------------------------------------------------
Tarjetas Activas =
    CALCULATE(COUNTROWS(control_acceso_tarjetas), control_acceso_tarjetas[estatus_responsiva] = "Activa")

Tarjetas Pendientes Responsiva =
    CALCULATE(COUNTROWS(control_acceso_tarjetas), control_acceso_tarjetas[estatus_responsiva] = "Pendiente")

Incidencias Acceso Abiertas =
    CALCULATE(COUNTROWS(incidencias_control_acceso), incidencias_control_acceso[requiere_atencion_proveedor] = TRUE())

% Puertas con Acceso Habilitado =
    DIVIDE(
        COUNTROWS(DISTINCT(control_acceso_tarjeta_puertas[puerta_id])),
        [Total Puertas],
        0
    )

// ---------------------------------------------------------------------------
// Personal / Recursos humanos
// ---------------------------------------------------------------------------
Personal Activo =
    CALCULATE(COUNTROWS(personal_hospital), personal_hospital[activo] = TRUE())

% Personal Activo =
    DIVIDE([Personal Activo], [Total Personal Hospital], 0)

Personal de Enfermeria =
    CALCULATE(COUNTROWS(personal_hospital),
        SEARCH("ENFERMER", UPPER(personal_hospital[coordinacion_nombre]), 1, 0) > 0)

Dias de Vacaciones Otorgados =
    SUMX(
        vacaciones_incidencias_fechas,
        IF(vacaciones_incidencias_fechas[vacaciones_incidencia_id] <> BLANK(), 1, 0)
    ) -- equivale a COUNTROWS de fechas; se usa para medir dias

Cuentas Negativas =
    CALCULATE(COUNTROWS(cuentas_usuario), cuentas_usuario[se_da_negativa] = TRUE())

% Cuentas Negativas =
    DIVIDE([Cuentas Negativas], [Total Cuentas Usuario], 0)

// ---------------------------------------------------------------------------
// Tiempo (ejemplos YTD/QTD sobre documentos)
// ---------------------------------------------------------------------------
Oficios Recibidos YTD =
    CALCULATE([Total Oficios Recibidos], DATESYTD(Dim_Fecha[Date]))

Oficios Recibidos QTD =
    CALCULATE([Total Oficios Recibidos], DATESQTD(Dim_Fecha[Date]))

Notas Informativas YTD =
    CALCULATE([Total Notas Informativas], DATESYTD(Dim_Fecha[Date]))

Ingresos Suministro YTD =
    CALCULATE([Total Ingresos Suministro], DATESYTD(Dim_Fecha[Date]))