// SGTI_Measures_v2.dax
// Medidas derivadas (segunda tanda). NO duplica las de SGTI_Measures.dax:
// estas son ratios per-capita, ratios de contestacion/entrega y variacion MoM.
// Pegue cada medida con "Modelo > Nueva medida" (o en bloque con DAX Studio).
// Nota: las medidas de SGTI_Measures.dax (Total Personal TI, Unidades Entregadas,
// Licencias Activas, Oficios Contestados, etc.) se referencian por nombre y deben
// existir primero.

// ---------------------------------------------------------------------------
// Per-capita / productividad
// ---------------------------------------------------------------------------

// Responde: cuantos oficios realiza cada empleado de TI en promedio.
// Pestana de reporte: Documentos.
Oficios por Empleado TI =
    DIVIDE([Total Oficios Realizados], [Total Personal TI])

// Responde: unidades de suministro entregadas por cada empleado del hospital.
// Pestana de reporte: Suministros.
Entregas Per Capita =
    DIVIDE([Unidades Entregadas], [Total Personal Hospital])

// Responde: cuantas reubicaciones de equipo atiende cada tecnico de TI.
// Pestana de reporte: Activos / Equipo.
Reubicaciones por Tecnico =
    DIVIDE([Total Reubicaciones], [Total Personal TI])

// Responde: licencias activas por cada empleado de TI (presion de licenciamiento).
// Pestana de reporte: Activos / Equipo.
Licencias por Empleado TI =
    DIVIDE([Licencias Activas], [Total Personal TI])

// Responde: unidades entregadas en promedio por cada movimiento de entrega.
// Pestana de reporte: Suministros.
Promedio Unidades por Entrega =
    DIVIDE([Unidades Entregadas], [Total Entregas Suministro])

// Responde: contador total promedio de las impresoras entregadas (vida util).
// Pestana de reporte: Suministros.
Promedio Contador Impresoras =
    AVERAGE(entregas_suministro[contador_total])

// ---------------------------------------------------------------------------
// Ratios de contestacion / entrega / negativas
// ---------------------------------------------------------------------------

// Responde: proporcion de oficios recibidos que fueron contestados.
// Nota: equivale a "% Of. Recibidos Contestados" de SGTI_Measures.dax con otro
// nombre; uselo solo si quiere un nombre corto en las tarjetas.
// Pestana de reporte: Documentos.
Ratio Contestacion Oficios =
    DIVIDE([Oficios Contestados], [Total Oficios Recibidos])

// Responde: proporcion de oficios realizados que ya se entregaron.
// Pestana de reporte: Documentos.
% Oficios Entregados =
    DIVIDE([Oficios Entregados], [Total Oficios Realizados])

// Responde: proporcion de oficios realizados que se cancelaron.
// Pestana de reporte: Documentos.
% Oficios Cancelados =
    DIVIDE([Oficios Cancelados], [Total Oficios Realizados])

// Responde: proporcion de cuentas de usuario que ya fueron entregadas.
// IMPORTANTE (calidad de datos): cuentas_usuario[estatus] esta sucio: mezcla
// "Entregado" (486), "Pendiente" (112), "Se realizo entrega de la solicitud" (42),
// "Se genero negativa a solicitud" (5) y hasta un objeto de Excel sin evaluar (1).
// Por eso NO se filtra por = "Entregada" (ese valor no existe): se usa SEARCH
// case-insensitive sobre "ENTREG" para capturar las dos variantes de entrega.
// Pestana de reporte: Personal y Accesos.
Cuentas Entregadas Ratio =
    DIVIDE(
        CALCULATE(
            COUNTROWS(cuentas_usuario),
            SEARCH("ENTREG", UPPER(cuentas_usuario[estatus]), 1, 0) > 0
        ),
        [Total Cuentas Usuario]
    )

// Responde: proporcion de cuentas de usuario con negativa registrada.
// Usa la bandera booleana (mas confiable que el texto de estatus).
// Pestana de reporte: Personal y Accesos.
% Cuentas con Negativa =
    DIVIDE([Cuentas Negativas], [Total Cuentas Usuario])

// ---------------------------------------------------------------------------
// Tiempo: variacion mes a mes (MoM)
// ---------------------------------------------------------------------------

// Responde: variacion % de oficios recibidos respecto al mes anterior.
// Requiere: relacion activa entre Dim_Fecha[Date] y oficios_recibidos[fecha_recepcion]
// (o la columna de fecha usada en el modelo). Usa VAR/RETURN para leer el mes actual
// y el anterior con DATEADD.
// Pestana de reporte: Ejecutivo (tarjeta de tendencia).
Variacion MoM Oficios Recibidos =
    VAR MesActual = [Total Oficios Recibidos]
    VAR MesAnterior =
        CALCULATE([Total Oficios Recibidos], DATEADD(Dim_Fecha[Date], -1, MONTH))
    RETURN
        DIVIDE(MesActual - MesAnterior, MesAnterior)

// Responde: variacion % de unidades ingresadas respecto al mes anterior.
// Requiere: relacion activa entre Dim_Fecha[Date] e ingresos_suministro[fecha_ingreso].
// Pestana de reporte: Suministros (tarjeta de tendencia).
Variacion MoM Ingresos =
    VAR MesActual = [Total Ingresos Suministro]
    VAR MesAnterior =
        CALCULATE([Total Ingresos Suministro], DATEADD(Dim_Fecha[Date], -1, MONTH))
    RETURN
        DIVIDE(MesActual - MesAnterior, MesAnterior)
